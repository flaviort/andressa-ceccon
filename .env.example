# Google Search Console HTML tag value (only the content="..." part). Optional.
GOOGLE_SITE_VERIFICATION=

# Contact form (src/app/contato/actions.ts). Without the key, dev logs the
# message to the terminal instead of sending; production shows an error.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Site Andressa Ceccon <site@andressaceccon.com.br>".
# Defaults to onboarding@resend.dev, which only delivers to the Resend account owner.
RESEND_FROM=
# Inbox that receives the messages. Defaults to site.contactInbox in src/lib/site.ts.
CONTACT_TO=
